FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app
COPY . .

RUN mvn clean package

FROM tomcat:9.0

RUN rm -rf /usr/local/tomcat/webapps/*

COPY --from=build /app/target/pms.war /usr/local/tomcat/webapps/pms.war
COPY --from=build /app/target/app/src/main/resources/db.properties.example /usr/local/tomcat/webapps/db.properties.template
COPY ./docker/prod-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
